# PiRO systemd unit template.
#
# Don't copy this by hand: the @USER@, @DIR@ and @NODE@ placeholders are
# filled in by the sed command in README.md's "Running PiRO as a systemd
# service" section, which writes the result to /etc/systemd/system/piro.service.
#
# All of PiRO's settings live in /etc/piro/piro.env (see deploy/piro.env.example),
# not in this file, so upgrading the unit never overwrites your configuration.

[Unit]
Description=PiRO - Icom CI-V and audio remote control
Wants=network-online.target
After=network-online.target sound.target

[Service]
Type=simple
User=@USER@
# The USB CI-V serial port needs "dialout" and the ALSA codec needs "audio".
# Granting them here means the service works even if @USER@ isn't in those groups.
SupplementaryGroups=dialout audio
WorkingDirectory=@DIR@
EnvironmentFile=/etc/piro/piro.env
ExecStart=@NODE@ src/server/index.js
Restart=on-failure
RestartSec=5
# PiRO shuts down cleanly on SIGTERM (releases the serial port, stops
# arecord/aplay and any denoiser child processes).
TimeoutStopSec=10

# --- Hardening: what PiRO, and anything it starts, may not do ---
# No gaining privileges (setuid programs, file capabilities), and no
# capabilities at all: PiRO runs as an ordinary user and needs none.
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
# /usr, /boot and /etc read-only. Not "strict": the save folders
# (SSTV_SAVE_DIR, FAX_SAVE_DIR, EASYPAL_SAVE_DIR) can be anywhere, and the
# fax state file is in ~/.config/piro.
ProtectSystem=full
# A /tmp of its own.
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# Network (the web app, wsprnet, PSK Reporter, Deepgram), local sockets,
# and netlink (finding serial ports).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Deliberately not set, because they would break PiRO:
# - PrivateDevices, DevicePolicy, ProtectClock, ProtectKernelLogs: they
#   restrict /dev, hiding the radio's serial port and sound card.
# - MemoryDenyWriteExecute: Node's JIT and WebAssembly need it.
# - ProtectHome, ProtectSystem=strict: PiRO runs from, and saves to, your
#   home folder (or wherever the save folders are).
# - SystemCallFilter, RestrictRealtime: not yet tried on a Pi.
# If something stops working, see "Running PiRO as a systemd service" in
# the README for how to turn one of these off.

[Install]
WantedBy=multi-user.target
