# PiRO configuration, read by systemd via EnvironmentFile=/etc/piro/piro.env
#
# Install with:  sudo install -D -m 644 deploy/piro.env.example /etc/piro/piro.env
# then edit it. Lines starting with # are ignored. Values may be quoted.
# After any change:  sudo systemctl restart piro
#
# Every variable is optional except as noted; the defaults shown are what the
# server uses when the line is absent. README.md has the full explanation of each.

# --- Radio control (CI-V over USB) -------------------------------------------
CIV_SERIAL_PATH=/dev/ttyUSB0
CIV_RADIO_MODEL=IC-7300
# Must match the radio's own "CI-V USB Baud Rate" menu setting exactly.
# The spectrum scope usually needs 115200.
CIV_BAUD_RATE=19200
# Spectrum scope / waterfall (adds continuous CI-V traffic; needs a high baud rate).
#CIV_SCOPE_ENABLED=true
# At startup, set the radio's USB AF-output and USB MOD-input levels to maximum.
# Default is on; set to 0 to leave your radio's own levels alone.
#CIV_MAXIMIZE_USB_LEVELS=0

# --- Audio (ALSA, the radio's built-in USB codec) ----------------------------
# Audio is disabled entirely when this is unset. Find yours with: arecord -l
# This also enables the CW/RTTY/FT8 decoders, which run off the same RX audio.
AUDIO_RX_DEVICE=plughw:CODEC,0
#AUDIO_TX_DEVICE=plughw:CODEC,0
#AUDIO_SAMPLE_RATE=48000

# --- Web server --------------------------------------------------------------
#WS_PORT=8080
SCREEN_TITLE="My Shack Radio"
# Needed for microphone access from other devices on your network
# (browsers only allow the mic on HTTPS pages). See docs/pwa-notes.md.
#TLS_CERT_PATH=/etc/piro/cert.pem
#TLS_KEY_PATH=/etc/piro/key.pem
# PiRO is AGPL-3.0: if other people use your instance, point this at your
# copy of the source (e.g. your GitHub fork). The UI then shows a "Source" link.
#SOURCE_CODE_URL=https://github.com/YOUR-USER/PiRO

# --- Your station (FT8 composer, guided FT8 QSOs, FreeDV Reporter) -----------
#STATION_CALLSIGN=VK3TR
#STATION_GRID=QF22
# Set to 0 to never report to the FreeDV Reporter map (it is also opt-in per
# session via the UI's "FDV Spot" checkbox).
#FREEDV_REPORTER_ENABLED=0

# --- Noise reduction ---------------------------------------------------------
# RNNoise ("RNN" button): needs the patched rnnoise_demo from third_party/rnnoise
# installed on PATH, or give its full path. See README.md, "RNNoise".
#RNNOISE_BIN=/usr/local/bin/rnnoise_demo
# One blend ratio per RNN button level (0.0 = untouched audio, 1.0 = fully
# denoised). The number of values sets the number of levels on the button.
#RNNOISE_WET=0.25,0.5,0.75,1.0
# HamNoise button: bundled, no install. "classic" is light enough for a Pi;
# only use "v2" on hardware you have confirmed can keep up in real time.
#HAMNOISE_QUALITY=classic

# --- FreeDV RADE (optional, needs rade_c built and installed) ----------------
#RADE_TX_BIN=radae_tx
#RADE_RX_BIN=radae_rx
#LPCNET_DEMO_BIN=lpcnet_demo
#RADE_TX_GAIN=4

# --- RTTY / JTTY / Olivia -------------------------------------------
# Audio frequency (Hz) of JTTY's lowest tone; the signal spans this +94 Hz.
# The default centres it on ~1500 Hz.
#JTTY_TX_FREQ_HZ=1450
# Audio range (Hz) searched when decoding JTTY (two fixed channels at
# 1350 and 1650 Hz are always searched too). The default is the whole
# passband the decoder supports; narrowing it saves a little CPU.
#JTTY_RX_LOW_HZ=200
#JTTY_RX_HIGH_HZ=2900
# Decoder effort / CPU use: economy (default), light, full, or auto.
#JTTY_RX_QUALITY=economy

# --- Olivia 8/250 ----------------------------------------------------
# Default audio centre frequency (Hz) for sending and receiving, until it
# is changed in the UI. The receiver searches 125 Hz either side of it.
#OLIVIA_FREQ_HZ=1500
# "off" turns off PiRO's junk-character filtering (decodes exactly as
# fldigi does with its squelch off).
#OLIVIA_SQUELCH=on

# --- Feld-Hell -------------------------------------------------------
# Default audio tone (Hz) for sending and receiving, until it is changed
# in the UI. Band frequencies the client tunes to assume this tone.
#HELL_TONE_HZ=1000

# --- VARA chat -------------------------------------------------------
# Needs STATION_CALLSIGN and 48 kHz audio. Bandwidth in Hz: 500 (VarAC's
# calling width), 2300 or 2750. Both stations must use the same.
#VARA_BW=500
# How far the transmit audio lags what is written to the sound card (ms).
# Try 300 or 800 if VARA calls never connect.
#VARA_AUDIO_LATENCY_MS=500
# Your name and QTH, sent after the opening report as VarAC's profile
# (STATION_GRID goes with them as the locator).
#VARA_NAME=Steve
#VARA_QTH=Melbourne

# --- SSTV ------------------------------------------------------------
# Also save every received SSTV picture in this folder as a PNG (it is
# created if missing; the service's user must be able to write there).
#SSTV_SAVE_DIR=/home/pi/sstv
# SSTV transmit mode (Scottie 1 by default): S1, S2, SDX, M1, M2, R36, R72,
# PD90, PD120, PD180, ... (see src/audio/sstv-modes.js).
#SSTV_TX_MODE=S1
# TX power (W) while sending SSTV, put back afterwards (SSTV is a full-power
# tone for minutes). Unset leaves the power alone.
#SSTV_TX_POWER_W=50
# "off" leaves out the FSK ID / CW ID (callsign from STATION_CALLSIGN).
#SSTV_FSK_ID=on
#SSTV_CW_ID=on

# --- Speech to text (the "STT" checkbox) ------------------------------
# whisper.cpp's server and a model (see the README, "whisper.cpp"). PiRO
# starts it while STT is ticked.
#STT_WHISPER_SERVER=/opt/whisper.cpp/build/bin/whisper-server
#STT_MODEL=/opt/whisper.cpp/models/ggml-base.en-q5_1.bin
#STT_THREADS=4
# A long over is sent in pieces this long (5 to 28 s) so its text comes as
# it goes. Longer is a little more accurate, but later.
#STT_MAX_SEGMENT_SEC=10
# Or one already running on another computer, instead of the two above:
#STT_URL=http://192.168.1.20:8178
