;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;startArrow=diamondThin;startFill=1;startSize=14;endArrow=none;exitX=0.04;exitY=1;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="ep-c-21" target="ep-c-51"><mxGeometry relative="1" as="geometry" x="0.55"><Array as="points"><mxPoint x="5650" y="1325" /></Array></mxGeometry></mxCell><mxCell id="ep-e-60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="ep-c-51" target="ep-c-53"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ep-e-61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="ep-c-51" target="ep-c-57"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5908" y="1325" /></Array></mxGeometry></mxCell><mxCell id="ep-n-62" value="&lt;b&gt;WSPRnet&lt;/b&gt;&lt;br&gt;wsprnet.org (HTTP)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="4670" y="1880" width="230" height="56" /></mxCell><mxCell id="ep-e-63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;exitX=1;exitY=0.1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="ep-c-5" target="ep-n-62"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4785" y="700" /></Array></mxGeometry></mxCell><mxCell id="ep-n-64" value="&lt;b&gt;wspr.live&lt;/b&gt;&lt;br&gt;spots database (HTTPS)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry as="geometry" x="4810" y="1960" width="230" height="56" /></mxCell><mxCell id="ep-e-65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="ep-c-9" target="ep-n-64"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="evt" name="2. Event wiring"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t2" value="&lt;b style='font-size:20px'&gt;PiRO — runtime event wiring (server)&lt;/b&gt;&lt;br&gt;Who listens to what, and what each part sends back. ControlServer turns client requests into internal events (left column); bridges answer by broadcasting to every connected browser." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1500" height="60" as="geometry" /></mxCell><mxCell id="tbl" value="&lt;table style='border-collapse:collapse;font-size:11px;font-family:Helvetica'&gt;&lt;tr&gt;&lt;th style='background:#d5e8d4;border:1px solid #82b366;padding:6px;text-align:left;width:150px'&gt;Component&lt;/th&gt;&lt;th style='background:#d5e8d4;border:1px solid #82b366;padding:6px;text-align:left;width:330px'&gt;Listens to (ControlServer events unless noted)&lt;/th&gt;&lt;th style='background:#d5e8d4;border:1px solid #82b366;padding:6px;text-align:left;width:170px'&gt;Reads RX PCM&lt;br&gt;(audioBridge.capture 'data')&lt;/th&gt;&lt;th style='background:#d5e8d4;border:1px solid #82b366;padding:6px;text-align:left;width:170px'&gt;Writes TX PCM&lt;br&gt;(audioBridge.playback.write)&lt;/th&gt;&lt;th style='background:#d5e8d4;border:1px solid #82b366;padding:6px;text-align:left;width:330px'&gt;Sends to browsers&lt;/th&gt;&lt;th style='background:#d5e8d4;border:1px solid #82b366;padding:6px;text-align:left;width:230px'&gt;Radio / PTT&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;ControlServer&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;CivDriver: frequency, mode, error; every client request&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;connected (to each new client); frequency, mode, data-mode, ptt, ptt-timeout, rig-error; echoes of setting changes (variants, spot boxes, RNN / HamNoise, RTTY reverse)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;calls civ.setPtt() (also from the 10-min watchdog)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;&lt;b&gt;AudioBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;rnnoise-level, hamnoise-enabled, binary-message (mic audio); CivDriver: mode&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;owns capture&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;owns playback&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;audio-error, rnnoise-level, hamnoise-enabled; binary AUDIO&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;ScopeBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;CivDriver: scope-line&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;scope-error; binary SCOPE_LINE&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;civ.enableScopeOutput(), setScopeMode()&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;&lt;b&gt;CwDecoderBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;ptt, cw-decoder-variant; CivDriver: mode&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;yes (CW mode, RX only)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;cw-text, rig-error, audio-error&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;civ.getCwPitch(), getMode()&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;RttyDecoderBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;ptt, rtty-reversed; CivDriver: mode&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;yes (RTTY mode, RX only)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;rtty-text&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;civ.getMode()&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;&lt;b&gt;JttyDecoderBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;ptt, jtty-active&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;yes (while armed, RX only)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;jtty-text, audio-error; binary FT8_SPECTRUM&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;Ft8Bridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;ptt, ft8-active, ft8-send, ft8-variant, psk-spot-enabled&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;yes (while armed)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;yes (TX at slot boundary)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;ft8-decodes, ft8-tx-status, rig-error; binary FT8_SPECTRUM&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;setPttFromServer(on / off)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;&lt;b&gt;TtyBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;tty-send, tty-abort&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;yes (RTTY / JTTY / Olivia / Feld-Hell TX)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;tty-tx-status&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;setPttFromServer(on / off)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;OliviaDecoderBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;ptt, olivia-active (with the centre frequency)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;yes (while armed, RX only)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;olivia-text, audio-error; binary FT8_SPECTRUM&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;&lt;b&gt;HellDecoderBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;ptt, hell-active (with the tone)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;yes (while armed, RX only)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;audio-error; binary HELL_COLUMNS (the picture), FT8_SPECTRUM&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;SstvDecoderBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;ptt, sstv-active, sstv-end-picture&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;yes (while armed, RX only)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;sstv-start, sstv-picture (PNG), sstv-fsk-id, audio-error; binary SSTV_LINE, FT8_SPECTRUM&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;&lt;b&gt;SstvTxBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;sstv-send, sstv-abort&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;yes (SSTV TX)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;sstv-tx-status, sstv-picture (own)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;civ.setDataMode(), get/setTxPower(); setPttFromServer(on / off)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;RadeBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;ptt, freedv-active, freedv-variant, binary-message (mic audio)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;yes (RX)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;yes (TX modem audio)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;audio-error; binary AUDIO (decoded speech)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;— (voice PTT from the client)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;&lt;b&gt;FreeDvReporterBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;ptt, frequency, freedv-active, freedv-spot-enabled, freedv-variant, freedv-message&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;— (reports to qso.freedv.org)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;&lt;b&gt;CwTxBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;cw-send, cw-abort, client-disconnected&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;— (the radio keys itself)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;cw-tx-status&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;civ.sendCw(), stopCw(), get/setKeySpeed(), get/setBreakIn()&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;WsprBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;ptt, wspr-active, wspr-tx, client-connected / -disconnected; SlotClock: boundary&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;yes (while on, not on a TX slot)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;yes (TX slots)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;wspr-status, wspr-decodes, frequency, data-mode, audio-error; binary FT8_SPECTRUM; emits wspr-slot-decoded&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;civ.setDataMode(), setTxPower(), setFrequency(), setTuner(); setPttFromServer(on / off)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;&lt;b&gt;BandConditions&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;wspr-slot-decoded (from WsprBridge)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;— (answers getBandConditions)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;FaxDecoderBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;ptt, fax-active, fax-start-now, fax-stop&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;yes (while on, RX only)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;fax-status, fax-start, fax-picture (PNG), audio-error; binary FAX_LINE&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;ReceiveRadioSetup: NR, auto notch, filter (put back)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;&lt;b&gt;EasypalDecoderBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;ptt, easypal-active&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;yes (while on, RX only)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;easypal-status, easypal-preview, easypal-picture, audio-error; binary FT8_SPECTRUM&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#f1f8f0'&gt;ReceiveRadioSetup: NR, auto notch, filter (put back)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;&lt;b&gt;EasypalTxBridge&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;easypal-send, easypal-abort, client-connected / -disconnected&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;—&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;yes (EasyPal TX)&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;easypal-tx-status, easypal-picture (own), audio-error&lt;/td&gt;&lt;td style='border:1px solid #b9d6b3;padding:6px;vertical-align:top;background:#ffffff'&gt;civ.setDataMode(), get/setTxPower(); setPttFromServer(on / off)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1400" height="760" as="geometry" /></mxCell><mxCell id="note2" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Every bridge only attaches to the PCM stream while its mode is active and PTT is off (decoders), so a decoder for a mode that is not selected does no work.&lt;br&gt;• The heavy decoders and encoders (FT8, JTTY, Olivia, SSTV, WSPR, EasyPal) run in worker threads, so decoding does not hold up CI-V, audio and WebSocket handling on the main event loop.&lt;br&gt;• In the browser, RigLink re-dispatches every server event as a DOM CustomEvent; app.js is the only module that subscribes to them." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="1400" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>